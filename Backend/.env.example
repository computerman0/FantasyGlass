# Use Node 24+ with: node --env-file=.env dist/src/server.js
# Generate these locally using: node scripts/generate-secrets.mjs
OWNER_TOKEN=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
DATABASE_PATH=./data/fantasyglass.sqlite
BIND_HOST=127.0.0.1
PORT=8080
APNS_ENVIRONMENT=sandbox
APNS_TEAM_ID=YOURTEAMID
APNS_KEY_ID=YOURKEYID
APNS_BUNDLE_ID=com.yourname.FantasyGlass
# Keep the .p8 file outside the source checkout, mode 0600.
# APNS_KEY_FILE=/run/secrets/AuthKey_YOURKEYID.p8
# Optional direct TLS. Otherwise use the included reverse-proxy example.
# TLS_KEY_FILE=/etc/fantasyglass/tls/key.pem
# TLS_CERT_FILE=/etc/fantasyglass/tls/fullchain.pem
